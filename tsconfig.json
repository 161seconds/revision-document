{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "typescript/**/*",
    ".agents/skills/systematic-debugging/condition-based-waiting-example.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
