{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Event contract",
  "description": "Structural authoring schema. scripts/validate.py additionally checks semantic references, content hashes and evidence linkage; it is not a generic JSON Schema evaluator.",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 1},
    "change_id": {"type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "timestamp": {"type": "string", "minLength": 1, "format": "date-time", "pattern": "Z$"},
    "event_type": {"enum": ["source-read", "claim-checked", "change-proposed", "record-curated", "check-run", "status-changed", "correction"]},
    "actor": {"type": "object", "properties": {"kind": {"enum": ["agent", "human", "tool"]}, "name": {"type": "string", "minLength": 1}}, "required": ["kind", "name"]},
    "record_refs": {"type": "array", "items": {"type": "object", "properties": {"collection": {"enum": ["recipes", "knowledge"]}, "record_id": {"type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"}, "revision": {"type": "integer", "minimum": 1}, "provenance_ref": {"type": "string", "minLength": 1, "pattern": "^(git:[0-9a-f]{40}:.+\\.json|snapshot:sha256:[0-9a-f]{64}:evidence/dataset-changes/[^/]+/snapshots/(recipes|knowledge)/[^/]+/[1-9][0-9]*/[0-9a-f]{64}\\.json)$"}}, "required": ["collection", "record_id", "revision"]}, "minItems": 1},
    "summary": {"type": "string", "minLength": 1},
    "payload": {"type": "object"}
  },
  "required": ["schema_version", "event_id", "change_id", "timestamp", "event_type", "actor", "record_refs", "summary", "payload"],
  "allOf": [{"if": {"properties": {"event_type": {"const": "source-read"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/source-read"}}}}, {"if": {"properties": {"event_type": {"const": "claim-checked"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/claim-checked"}}}}, {"if": {"properties": {"event_type": {"const": "change-proposed"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/change-proposed"}}}}, {"if": {"properties": {"event_type": {"const": "record-curated"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/record-curated"}}}}, {"if": {"properties": {"event_type": {"const": "check-run"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/check-run"}}}}, {"if": {"properties": {"event_type": {"const": "status-changed"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/status-changed"}}}}, {"if": {"properties": {"event_type": {"const": "correction"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/correction"}}}}],
  "$defs": {
    "source-read": {"type": "object", "properties": {"source_id": {"type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"}, "locator": {"type": "string", "minLength": 1}, "source_version": {"type": "string", "minLength": 1}, "accessed_at": {"type": "string", "minLength": 1, "format": "date"}, "supported_claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"}, "minItems": 1}}, "required": ["source_id", "locator", "source_version", "accessed_at", "supported_claim_ids"]},
    "claim-checked": {"type": "object", "properties": {"claim_id": {"type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"}, "status": {"enum": ["verified", "uncertain", "rejected"]}, "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 0}, "source_refs": {"type": "array", "items": {"type": "object", "properties": {"source_id": {"type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"}, "locator": {"type": "string", "minLength": 1}}, "required": ["source_id", "locator"]}, "minItems": 1}, "remaining_uncertainty": {"type": "string", "minLength": 1}}, "required": ["claim_id", "status", "assumptions", "source_refs", "remaining_uncertainty"]},
    "change-proposed": {"type": "object", "properties": {"before_hash": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]}, "after_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "hash_algorithm": {"const": "sha256"}, "canonicalization": {"const": "UTF-8 JSON; sorted keys; compact separators; ensure_ascii=false"}, "before_ref": {"type": "object", "properties": {"collection": {"enum": ["recipes", "knowledge"]}, "record_id": {"type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"}, "revision": {"type": "integer", "minimum": 1}, "provenance_ref": {"type": "string", "minLength": 1, "pattern": "^(git:[0-9a-f]{40}:.+\\.json|snapshot:sha256:[0-9a-f]{64}:evidence/dataset-changes/[^/]+/snapshots/(recipes|knowledge)/[^/]+/[1-9][0-9]*/[0-9a-f]{64}\\.json)$"}}, "required": ["collection", "record_id", "revision"]}}, "required": ["before_hash", "after_hash", "hash_algorithm", "canonicalization"]},
    "record-curated": {"type": "object", "properties": {"status": {"enum": ["draft", "active", "deprecated"]}, "rationale": {"type": "string", "minLength": 1}, "runtime_status": {"enum": ["not-run", "passed", "failed", "unavailable", "skipped"]}, "artifact_ref": {"type": ["string", "null"]}}, "required": ["status", "rationale", "runtime_status", "artifact_ref"], "allOf": [{"if": {"properties": {"runtime_status": {"const": "passed"}}}, "then": {"properties": {"artifact_ref": {"type": "string", "minLength": 1}}}}]},
    "check-run": {"type": "object", "properties": {"check_id": {"type": "string", "minLength": 1}, "status": {"enum": ["passed", "failed", "not-run", "unavailable", "skipped"]}, "method": {"type": "string", "minLength": 1}, "input_revision": {"type": "integer", "minimum": 1}, "artifact_ref": {"type": ["string", "null"]}, "output_ref": {"type": ["string", "null"]}, "observed_by": {"type": "string", "minLength": 1}, "observed_result": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "tolerance": {"type": "string", "minLength": 1}, "regime": {"type": "string", "minLength": 1}}, "required": ["check_id", "status", "method", "input_revision", "artifact_ref", "output_ref"], "allOf": [{"if": {"properties": {"status": {"enum": ["passed", "failed"]}}}, "then": {"required": ["observed_by", "observed_result"]}, "else": {"required": ["reason"]}}, {"if": {"anyOf": [{"required": ["tolerance"]}, {"required": ["regime"]}]}, "then": {"required": ["tolerance", "regime"]}}]},
    "status-changed": {"type": "object", "properties": {"before_status": {"enum": ["draft", "active", "deprecated"]}, "after_status": {"enum": ["draft", "active", "deprecated"]}, "reason": {"type": "string", "minLength": 1}}, "required": ["before_status", "after_status", "reason"]},
    "correction": {"type": "object", "properties": {"target_event_id": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}, "required": ["target_event_id", "reason"]}
  }
}
