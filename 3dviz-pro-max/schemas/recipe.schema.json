{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recipe contract",
  "description": "Structural authoring schema. scripts/validate.py additionally checks semantic references, content hashes and evidence linkage; it is not a generic JSON Schema evaluator.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^recipe\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "deprecated"
      ]
    },
    "record_kind": {
      "enum": [
        "creative",
        "factual",
        "mixed"
      ]
    },
    "title": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en"
      ]
    },
    "aliases": {
      "type": "object",
      "properties": {
        "en": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "en"
      ]
    },
    "direction_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "locator"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "statement",
          "scope",
          "source_refs"
        ]
      },
      "minItems": 0
    },
    "defaults": {
      "type": "object",
      "description": "Starting values with rationale. provenance=authored: tunable creative numbers, no citation required; provenance=source-backed: claim_ids must name claims of this record that support the values.",
      "properties": {
        "provenance": {
          "enum": [
            "authored",
            "source-backed"
          ]
        },
        "tunable": {
          "type": "boolean"
        },
        "values": {
          "type": "object",
          "minProperties": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          }
        }
      },
      "required": [
        "provenance",
        "tunable",
        "values",
        "rationale"
      ],
      "if": {
        "properties": {
          "provenance": {
            "const": "source-backed"
          }
        }
      },
      "then": {
        "required": [
          "claim_ids"
        ],
        "properties": {
          "claim_ids": {
            "minItems": 1
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "guidance": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      },
      "minItems": 0
    },
    "state_contract": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "model",
        "authority",
        "actions"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "subject_terms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "intent_signals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "example_prompts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "negative_signals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "not_for": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "motion_guidance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "creative_affordances": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "known_limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "object_craft": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1
          },
          "structure": {
            "type": "string",
            "minLength": 1
          },
          "material": {
            "type": "string",
            "minLength": 1
          },
          "articulation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "family",
          "structure",
          "material"
        ]
      }
    },
    "physical_contract": {
      "type": "object",
      "properties": {
        "model": {
          "enum": [
            "display-transform",
            "controlled-locomotion",
            "rigid-body",
            "numerical-dynamics",
            "none"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "timestep": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "colliders": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "driving": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contact": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "model",
        "scope"
      ]
    },
    "related_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(recipe|knowledge)\\.[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "revision",
    "status",
    "record_kind",
    "title",
    "aliases",
    "direction_ids",
    "summary",
    "objective"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "record_kind": {
            "enum": [
              "factual",
              "mixed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "claims"
        ],
        "properties": {
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
                },
                "statement": {
                  "type": "string",
                  "minLength": 1
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "source_refs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
                      },
                      "locator": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "source_id",
                      "locator"
                    ]
                  },
                  "minItems": 1
                }
              },
              "required": [
                "id",
                "statement",
                "scope",
                "source_refs"
              ]
            },
            "minItems": 1
          }
        }
      }
    }
  ]
}
