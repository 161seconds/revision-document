{"schema_version": 1, "change_id": "looks-defaults-render-abstract", "timestamp": "2026-09-08T08:35:13Z", "actor": {"kind": "agent", "name": "worker-a2"}, "record_refs": [{"collection": "knowledge", "record_id": "knowledge.style-minimalist", "revision": 2}], "event_id": "looks-defaults-render-abstract.knowledge.style-minimalist.revision-2.proposed", "event_type": "change-proposed", "summary": "Add authored defaults and drop shared boilerplate", "payload": {"before_hash": "021e4937caba4ba8930c552ca7ebf3359bc1f1c70c300238654998c664ff3a85", "after_hash": "5bf3c5053a54f1cce3782f46b884984ac06c3dd31c826702cb85f6d07b3e795e", "before_ref": {"collection": "knowledge", "record_id": "knowledge.style-minimalist", "revision": 1, "provenance_ref": "snapshot:sha256:021e4937caba4ba8930c552ca7ebf3359bc1f1c70c300238654998c664ff3a85:evidence/dataset-changes/looks-defaults-render-abstract/snapshots/knowledge/knowledge.style-minimalist/1/021e4937caba4ba8930c552ca7ebf3359bc1f1c70c300238654998c664ff3a85.json"}, "hash_algorithm": "sha256", "canonicalization": "UTF-8 JSON; sorted keys; compact separators; ensure_ascii=false"}}
